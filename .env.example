# Copy to .env (never commit .env). Values below are for local development only.

# API base URL used by `bun run dev`. Leave empty in image builds: the built app
# calls the API with relative paths (/api/...), routed by the edge (CloudFront in
# AWS, the `edge` nginx container locally).
VITE_API_URL=http://localhost:8000

# Used by the Playwright E2E tests
MAILPIT_HOST=http://localhost:8025
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis
